# ---------- Públicas (llegan al navegador) ----------
# Clave de MapTiler (plan gratis) para imagen satelital y geocoding de alta resolución.
# Sin clave se usa Esri World Imagery + Nominatim como respaldo.
NEXT_PUBLIC_MAPTILER_KEY=

# URL del backend del equipo (modelo de rotaciones).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# true = usa los mocks locales (/api/mock) con el mismo contrato que el backend.
NEXT_PUBLIC_USE_MOCKS=true

# ---------- Solo servidor (nunca con prefijo NEXT_PUBLIC_) ----------
# Webhook del agente IA en n8n. Sin URL se usa el agente mock local.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Agente con Claude cuando no hay n8n (clave de https://console.anthropic.com). Solo servidor.
ANTHROPIC_API_KEY=
# true = fuerza el agente mock local (lo usan los e2e).
AGENT_FORCE_MOCK=false

# Reservado para respuestas en streaming (hoy se responde JSON).
N8N_STREAMING=false

# Ubicación por defecto cuando no hay headers de geolocalización por IP (desarrollo local).
DEFAULT_LAT=4.711
DEFAULT_LON=-74.072

# PostgreSQL (fincas publicadas y datos de mercado). Sin ella: memoria + seed de mercado.
# La URL real va solo en .env.local; nunca se comitea.
DATABASE_URL=
# Conexiones por instancia (por defecto 3) y SSL (por defecto require; "disable" para local).
DATABASE_POOL_MAX=
DATABASE_SSL=
# Secreto que n8n envía en X-FieldShift-Secret a /api/market/jobs/* (refresco de mercado y análisis IA).
MARKET_JOB_SECRET=
# Opcional: token de app de datos.gov.co (sube el límite de peticiones de SODA).
DATOS_GOV_APP_TOKEN=
